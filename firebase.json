{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/business", "destination": "/business-english", "type": 301 }
    ],
    "headers": [
      {
        "source": "/assets/fonts/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/assets/img/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
      },
      {
        "source": "/assets/@(css|js)/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
